# Домен для админки (для боевого запуска с https)
DOMAIN=bot.example.com

# Логин и пароль владельца при первом запуске
ADMIN_LOGIN=admin
# Токен бота от @BotFather
BOT_TOKEN=

# Пароль для входа в админку
ADMIN_PASSWORD=admin

# Любая случайная строка (подпись токенов сессии)
SECRET_KEY=change-me-please

# Пароль базы данных (задайте свой для боевого сервера)
DB_PASSWORD=change-this-db-password

# ---- База данных ----
# Если база на ОТДЕЛЬНОМ сервере (так правильно для боевого запуска) —
# впишите сюда адрес. Формат:
#   postgresql+asyncpg://sendbot:ПАРОЛЬ@10.0.0.3:5432/sendbot
# DATABASE_URL=
# DB_HOST=10.0.0.3          # тот же адрес, нужен контейнеру бэкапов


# Скорость рассылки, сообщений/сек (лимит ТГ ~30)
BROADCAST_RATE=20

# Автоочистка истории переписки и получателей рассылок старше N дней
# (0 = хранить вечно). На больших базах помогает не раздувать БД.
HISTORY_RETENTION_DAYS=0
