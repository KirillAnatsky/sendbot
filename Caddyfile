# Домен берётся из переменной DOMAIN в .env
# Caddy сам получит и будет продлевать бесплатный SSL-сертификат.
{$DOMAIN} {
	encode gzip
	# Ограничение размера загрузки. 120 МБ — чтобы проходил импорт базы
	# целиком: выгрузка на 400 тысяч подписчиков весит около 60 МБ, и резать
	# её на куски вручную — верный способ потерять часть людей.
	request_body {
		max_size 120MB
	}
	reverse_proxy app:8000
}
